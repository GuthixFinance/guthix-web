# ── RPC ──────────────────────────────────────────────────────────────────────
# A credential is NEVER a routing instruction, and never lives in this repo.
# Leave HELIUS_RPC_URL unset and everything runs on the public endpoint.
#
# Set it to the FULL URL including the key, e.g.
#   HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<key>
# The key reaches the server process only — public/swap.html has no key and must never
# get one. If Helius supports per-key domain restrictions, apply them to this key.
HELIUS_RPC_URL=
PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Hard monthly cap. Over budget the service degrades to PUBLIC_RPC_URL — it never throws.
# Fleet-wide the 1M/mo plan is split: tx-indexer 250k, control-panel 350k, this 200k,
# leaving ~200k reserve for bursts and one-off scripts.
HELIUS_MONTHLY_CREDIT_BUDGET=200000

# Shared fleet Postgres. Spend is persisted to the same `rpc_credits` table tx-indexer and
# control-panel write to, so total Helius usage is answerable from one query. Without it the
# meter still counts, but only in-process (a restart resets the total).
EVENTS_DATABASE_URL=
# EVENTS_DB_SSL=false   # set for a plaintext/local Postgres

# Extra addresses the public /api/rpc/* routes may be asked about, comma-separated.
# These routes cost money, so they accept an allowlist only — never arbitrary input.
PUBLIC_RPC_EXTRA_ADDRESSES=

# ── Dashboard (team-only routes) ─────────────────────────────────────────────
DASHBOARD_USER=
DASHBOARD_PASS=
